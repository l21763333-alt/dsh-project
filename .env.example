# ============ Recruit AI 环境变量模板 ============
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，严禁提交仓库

# ---- 基础 ----
DEBUG=true

# ---- 数据库（默认 MySQL；测试使用 sqlite:///:memory:）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=recruit
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=recruit_ai
# 或直接指定完整连接串（非空时优先）：
# DATABASE_URL=mysql+pymysql://recruit:your_mysql_password@127.0.0.1:3306/recruit_ai?charset=utf8mb4

# ---- DeepSeek LLM（API Key 必须通过环境变量注入）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ---- 文件存储（本地磁盘）----
# STORAGE_PATH=./data/files
